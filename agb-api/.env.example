# Copy to .env and adjust. Every variable is optional; the values below are
# the defaults (see src/config/config.schema.ts). Empty values count as unset.

# dev | prod | test. prod logs JSON to LOG_DIR and hides GraphQL stack traces;
# dev enables GraphiQL at /graphql.
APP_ENV=dev
SERVER_HOST=0.0.0.0
SERVER_PORT=3004
# Set to true behind a reverse proxy, so throttling and logs see client IPs.
TRUST_PROXY=false

DB_URL=mongodb://localhost:27017/ancGenomesDB15
DB_QUERY_TIMEOUT_MS=30000

# * or a comma-separated list of origins.
CORS_ORIGINS=*
# Cache-Control max-age for successful REST GETs (the data changes per release).
HTTP_CACHE_MAX_AGE=3600

# In-process result cache shared by REST and GraphQL.
CACHE_TTL_SECONDS=7200
CACHE_MAX_ENTRIES=500
# Row budget; one gene list weighs its row count (WHEAT alone is 102,802).
CACHE_MAX_ROWS=500000
SPECIES_INDEX_TTL_SECONDS=600

# Per client IP and route.
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=300

GRAPHQL_MAX_DEPTH=8
GRAPHQL_MAX_COMPLEXITY=150000
GRAPHQL_MAX_PAGE_SIZE=10000

# none: GO annotations answer 503 (pantree.org, the legacy source, is gone).
# database: read the PAINT arrays stored on each genelists document.
PAINT_ANNOTATIONS_SOURCE=none
# Reported by /api/stats.
PANTHER_VERSION=

LOG_LEVEL=info
LOG_DIR=logs
